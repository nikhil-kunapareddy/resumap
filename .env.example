# Which backend serves the model calls until one is chosen in the app's
# Settings panel (top right), which then wins over this.
#   api          -- the Anthropic API. Needs ANTHROPIC_API_KEY, billed per token.
#   claude_code  -- your local Claude Code install. No API key; uses whatever
#                   that install is signed in with (normally a Claude
#                   subscription) and spends that subscription's rate limits,
#                   shared with interactive Claude Code use.
#   codex        -- your local Codex CLI (`codex login`, normally a ChatGPT plan).
#   pi           -- your local pi coding agent, with its configured provider.
RESUMAP_BACKEND=api

# For the api backend (https://console.anthropic.com/settings/keys), unless you
# paste the key into the Settings panel instead, which wins over this.
# Ignored by the claude_code backend, which blanks it out for the subprocess so
# a key left here cannot silently bill you per token.
ANTHROPIC_API_KEY=sk-ant-...

# Optional
RESUMAP_FIRST_NAME=jane       # filename prefix: jane_companyname_mmdd.pdf
RESUMAP_MODEL=claude-opus-5
RESUMAP_CLAUDE_CLI=          # claude_code backend: path to the `claude` binary,
                             # only if it is not on this process's PATH
RESUMAP_CODEX_CLI=           # codex backend: path to `codex`, same caveat
RESUMAP_PI_CLI=              # pi backend: path to `pi`, same caveat
RESUMAP_DATA_DIR=            # optional: isolate storage for a second instance
RESUMAP_HOST=127.0.0.1
RESUMAP_PORT=8000

# Logging
RESUMAP_LOG_LEVEL=INFO       # DEBUG for per-block parser decisions
RESUMAP_LOG_DIR=             # defaults to <data>/logs
RESUMAP_LOG_PROMPTS=1        # archive full prompts+completions (contains resume text)
RESUMAP_PROMPT_ARCHIVE_MB=64 # cap on the prompt archive, oldest pruned
RESUMAP_LOG_TEXT=0           # 1 = also put truncated text samples in the JSONL
